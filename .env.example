# UniQuake Configuration
# Copy this file to .env and configure for your environment

# Public server IP or hostname (required)
# Note: For SSL/WSS to work properly, use a domain name (e.g., quake.example.com)
# instead of an IP address, as SSL certificates are issued for domain names
HOST_IP=localhost

# Port configurations
MASTER_PORT=27950
CONTENT_PORT=9000
WEB_PORT=8080
MOCK_PORT=8080

# Game server configuration
GAME_SERVER_IP=${HOST_IP}
GAME_SERVER_BASE_PORT=27961

# WebSocket URLs (automatically constructed from HOST_IP and ports)
MASTER_SERVER_WS=ws://${HOST_IP}:${MASTER_PORT}
CONTENT_SERVER_URL=${HOST_IP}:${CONTENT_PORT}

# STUN/TURN configuration
STUN_PORT=3478
STUN_PORT_SECONDARY=3479
TURN_PORT=3478
TURN_REALM=uniquake.com

# Logging
LOG_LEVEL=info

# ─── Docker / SSL Configuration ─────────────────────────────────────────────
# These settings are used by start-quake.sh for Docker deployment.
# For non-Docker usage, these can be ignored.

# SSL/TLS — managed automatically by ssl-manager inside the container
# SSL_DOMAIN=quake.example.com     # Domain for Let's Encrypt certificate
# SSL_ADMIN_EMAIL=admin@example.com # Email for Let's Encrypt registration
# SSL_REQUIRED=true                 # Fail if SSL setup fails (default: true)
# SSL_STAGING=true                  # Use Let's Encrypt staging (test certs)
# SSL_TEST_MODE=true                # Self-signed cert for dev/CI

# HAProxy — auto-registration for domain-based routing
# HAPROXY_HOST=haproxy              # HAProxy hostname (default: haproxy)
# HAPROXY_NET=haproxy-net           # HAProxy Docker network
# HAPROXY_API_KEY=                  # Bearer token for HAProxy Registration API

# Docker container settings
# CONTAINER_NAME=uniquake           # Docker container name
# UNIQUAKE_IMAGE=uniquake:latest    # Docker image name
# DATA_VOLUME=uniquake-data         # Persistent data volume
# APP_NET=uniquake-net              # Docker network name
